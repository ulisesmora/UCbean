# Production. Used by `next build` and `next start`. On Vercel, set these in
# the project Environment Variables instead; this file is never committed.

NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app/api/v1
NEXT_PUBLIC_USE_MOCKS=false

# Stripe, la mitad publica. Se llama NEXT_PUBLIC_ porque Next solo expone
# al navegador las variables con ese prefijo, y esta tiene que llegar ahi:
# es la que monta el formulario de tarjeta. Es publica por diseno, no es
# un secreto. La que empieza por sk_ jamas se pone aqui.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_REPLACE_ME

# La mitad publica de las claves VAPID. Con esta el navegador se suscribe;
# la privada se queda en el servidor y nunca sale de apps/api/.env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BK7zUModleTPdHe_nT1IO7fES7gASnGPjGVzoltTNBYKEb7LoQSwQxgyR_4b3OvNgKSeC1niluqaK21GKZ13p0I

# El client id de Google es publico por diseno: identifica la app, no
# autoriza nada. El secreto se queda en apps/api/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=590836361908-3j1ol3oso2h5jgj5f6do94uu4401nv4f.apps.googleusercontent.com
