generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OWNER
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  PICKUP
  DELIVERY
  TABLE
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?  @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  refreshToken String?

  /// Cuándo se confirmó el correo. Nulo mientras no se valide.
  emailVerifiedAt DateTime?
  /// Solo día y mes importan, pero se guarda la fecha completa.
  birthday        DateTime?
  /// Consentimiento explícito para correo y SMS de publicidad.
  /// Los avisos de un pedido no dependen de esto: son del servicio.
  marketingOptIn  Boolean   @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses         Address[]
  orders            Order[]
  notifications     Notification[]
  paymentMethods    PaymentMethod[]
  tableReservations TableReservation[]
  loyaltyCard         LoyaltyCard?
  discounts           Discount[]
  discountRedemptions DiscountRedemption[]
  pushSubscriptions   PushSubscription[]
  campaignDeliveries  CampaignDelivery[]
  verificationTokens  VerificationToken[]
  favorites           FavoriteDrink[]
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String
  street     String
  city       String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  /// Set when this menu row is a recipe. Its name, description and price
  /// then come from the recipe, kept in sync by the recipes service.
  recipe     Recipe?
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  type              OrderType
  status            OrderStatus @default(PENDING)
  total             Decimal     @db.Decimal(10, 2)
  deliveryAddressId String?
  notes             String?
  /// La llave que manda el navegador por cada intento de pedir. Un doble
  /// clic, un reintento por red lenta o dos pestañas mandan la misma y se
  /// devuelve el pedido que ya existe en vez de crear otro.
  idempotencyKey    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User                 @relation(fields: [userId], references: [id])
  deliveryAddress   Address?             @relation(fields: [deliveryAddressId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payment           Payment?
  pickupReservation PickupReservation?

  /// Por persona: la llave la inventa el navegador, y no hay por qué
  /// fiarse de que dos clientes nunca generen la misma.
  @@unique([userId, idempotencyKey])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  qty       Int
  unitPrice Decimal @db.Decimal(10, 2)

  /// The formula this line was built from: beans, size, serve, milk, foam,
  /// art, extras, vessel and sleeve. Same shape the configurator produces and
  /// the 3D preview renders, so a menu drink and a custom one are one record.
  options Json?

  /// Which menu recipe it came from, or null when the customer built it.
  recipeId String?

  /// What the customer was shown when they ordered, so a later price or
  /// recipe change never rewrites history.
  nameSnapshot   String?
  ticketSnapshot String?

  /// Extras on a menu item (oat milk, an extra shot). A built drink carries
  /// its extras inside the formula in `options` instead. Kept so a regular
  /// can repeat exactly the coffee they had, at today's price.
  extras String[] @default([])

  /// For here or to go, on a menu item. A built drink keeps it in its build.
  vessel String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PickupReservation {
  id               String   @id @default(uuid())
  orderId          String   @unique
  slotTime         DateTime
  confirmationCode String   @unique
  createdAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Table {
  id       String  @id @default(uuid())
  number   Int     @unique
  capacity Int
  zone     String?
  isActive Boolean @default(true)
  posX     Float?
  posY     Float?

  reservations TableReservation[]
}

model TableReservation {
  id          String            @id @default(uuid())
  userId      String
  tableId     String
  partySize   Int
  scheduledAt DateTime
  status      ReservationStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  table Table @relation(fields: [tableId], references: [id])
}

model PaymentMethod {
  id             String   @id @default(uuid())
  userId         String
  stripeMethodId String   @unique
  brand          String
  last4          String
  expMonth       Int
  expYear        Int
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id              String    @id @default(uuid())
  orderId         String    @unique
  paymentMethodId String?
  stripeIntentId  String?   @unique
  amount          Decimal   @db.Decimal(10, 2)
  status          String
  paidAt          DateTime?
  /// Con qué se pagó: card, apple_pay, google_pay, link. Lo dice Stripe al cobrar.
  method          String?
  /// El motivo del último intento fallido, tal como lo da Stripe.
  failureCode     String?
  failureMessage  String?
  amountRefunded  Decimal   @default(0) @db.Decimal(10, 2)
  updatedAt       DateTime  @default(now()) @updatedAt
  createdAt       DateTime  @default(now())

  order         Order          @relation(fields: [orderId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
}

/// Cada aviso de Stripe que tocó un pedido, pagado o no.
///
/// `stripeEventId` es único: Stripe reintenta el mismo `evt_...` hasta
/// recibir 200, y el índice es lo que impide aplicarlo dos veces.
/// Sin claves foráneas a propósito: un aviso puede llegar de un pedido
/// que ya no está, y el rastro tiene que guardarse igual.
model PaymentEvent {
  id             String   @id @default(uuid())
  stripeEventId  String   @unique
  type           String
  orderId        String?
  intentId       String?
  status         String?
  /// En centavos, como lo manda Stripe.
  amount         Int?
  currency       String?
  failureCode    String?
  failureMessage String?
  createdAt      DateTime @default(now())

  @@index([orderId, createdAt])
}

model Notification {
  id      String              @id @default(uuid())
  userId  String
  channel NotificationChannel
  /// Para qué es, así la cuenta puede filtrar y el cliente puede
  /// silenciar publicidad sin perder los avisos de su pedido.
  type    NotificationType    @default(ORDER)
  title   String
  body    String
  /// A qué apunta el aviso, cuando apunta a algo.
  orderId String?
  isRead  Boolean             @default(false)
  sentAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ─────────────────────────────────────────────────────────────
// Recetas
//
// Las bebidas vivían en un archivo del frontend, así que cambiar
// una de temporada exigía un despliegue. Aquí una receta es una
// fórmula guardada: el mismo objeto que produce el configurador
// y que se copia en la línea de pedido.
// ─────────────────────────────────────────────────────────────

enum RecipeKind {
  SIGNATURE
  SEASONAL
}

model Recipe {
  id     String     @id @default(uuid())
  /// Identificador estable que viaja en OrderItem.recipeId.
  slug   String     @unique
  name   String
  /// Nombre en su escritura original, cuando la bebida lo tiene.
  accent String?
  kind   RecipeKind @default(SIGNATURE)
  note   String

  /// La fórmula. Misma forma que OrderItem.options, así que el
  /// precio sale de la misma función y nunca se teclea.
  build Json

  season    String?
  /// Vigencia de una bebida de temporada. Nulo significa siempre.
  activeFrom DateTime?
  activeTo   DateTime?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)

  /// The product this recipe is sold as: what goes on the menu, in the bag
  /// and on the ticket. Created and kept in sync by the recipes service.
  /// A fixed menu price. Null charges the sum of its ingredients. Changes a
  /// customer makes to the recipe are added on top of either.
  priceOverride Decimal? @db.Decimal(10, 2)

  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

// ─────────────────────────────────────────────────────────────
// Lealtad
//
// El saldo no se guarda: se suma del libro de movimientos. Un
// contador mutable se desincroniza en cuanto algo falla a medias,
// y «tienes tantos puntos» es un número que el cliente va a creer.
// ─────────────────────────────────────────────────────────────

enum PointsReason {
  ORDER
  SIGNUP
  BIRTHDAY
  REDEMPTION
  MANUAL
  EXPIRY
}

enum RedemptionStatus {
  PENDING
  USED
  CANCELLED
}

model LoyaltyCard {
  id        String   @id @default(uuid())
  userId    String   @unique
  /// Sellos de la tarjeta de café, aparte de los puntos.
  stamps    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     PointsEntry[]
  redemptions RewardRedemption[]
}

model PointsEntry {
  id     String       @id @default(uuid())
  cardId String
  /// Positivo al ganar, negativo al canjear.
  delta  Int
  reason PointsReason
  /// El pedido que lo generó, cuando lo hubo.
  orderId String?
  note    String?
  createdAt DateTime @default(now())

  card LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  /// Los puntos de un pedido se dan una vez. Si el aviso de «entregado»
  /// llega dos veces, la segunda inserción choca aquí y no suma.
  @@unique([orderId, reason])
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String
  /// Lo que cuesta en puntos.
  cost        Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id       String           @id @default(uuid())
  cardId   String
  rewardId String
  /// Lo que el cliente enseña en el mostrador.
  code     String           @unique
  status   RedemptionStatus @default(PENDING)
  orderId  String?
  usedAt   DateTime?
  createdAt DateTime        @default(now())

  card   LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  reward Reward      @relation(fields: [rewardId], references: [id])

  @@index([cardId, status])
}

// ─────────────────────────────────────────────────────────────
// Descuentos
//
// Un descuento con userId nulo lo puede usar cualquiera. Con
// userId es un regalo para esa persona: el de bienvenida, el de
// cumpleaños. Una sola tabla porque la regla es la misma.
// ─────────────────────────────────────────────────────────────

enum DiscountKind {
  PERCENT
  AMOUNT
}

enum DiscountTrigger {
  SIGNUP
  BIRTHDAY
  FIRST_APP_ORDER
}

model Discount {
  id          String       @id @default(uuid())
  code        String       @unique
  description String
  kind        DiscountKind
  /// Porcentaje (0 a 100) o dinero, según kind.
  value       Decimal      @db.Decimal(10, 2)

  minOrderTotal  Decimal? @db.Decimal(10, 2)
  /// Nulo significa sin tope global.
  maxRedemptions Int?
  perUserLimit   Int      @default(1)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  /// Cuando es un regalo personal, de quién es.
  userId String?
  /// Qué lo generó automáticamente, si algo lo hizo.
  trigger DiscountTrigger?

  createdAt DateTime @default(now())

  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions DiscountRedemption[]

  @@index([userId, isActive])
}

model DiscountRedemption {
  id         String   @id @default(uuid())
  discountId String
  userId     String
  orderId    String?
  /// Lo que se descontó de verdad, ya calculado.
  amount     Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discountId, userId])
  /// Un cupón por pedido, garantizado por la base y no solo por el código.
  @@unique([orderId])
}

// ─────────────────────────────────────────────────────────────
// Avisos y campañas
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  ACCOUNT
  ORDER
  RESERVATION
  LOYALTY
  MARKETING
}

/// Suscripción del navegador a Web Push. Gratis y sin proveedor:
/// solo hacen falta unas llaves VAPID generadas en local.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CampaignAudience {
  ALL
  WITH_POINTS
  BIRTHDAY_MONTH
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Campaign {
  id       String              @id @default(uuid())
  name     String
  channel  NotificationChannel
  audience CampaignAudience    @default(ALL)
  subject  String?
  /// Admite {{nombre}} y {{puntos}}, que se sustituyen por persona.
  body     String
  status   CampaignStatus      @default(DRAFT)

  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deliveries CampaignDelivery[]

  @@index([status, scheduledAt])
}

model CampaignDelivery {
  id         String         @id @default(uuid())
  campaignId String
  userId     String
  status     DeliveryStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime       @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

// ─────────────────────────────────────────────────────────────
// Tokens de un solo uso
// ─────────────────────────────────────────────────────────────

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String       @id @default(uuid())
  userId    String
  /// Guardado como hash. El texto plano solo viaja en el correo.
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ─────────────────────────────────────────────────────────────
// Bebidas guardadas
//
// «Lo de siempre»: la fórmula que alguien pide una y otra vez,
// guardada con el nombre que ella le dé. Es el mismo objeto que
// produce el configurador, así que volver a pedirla es copiar la
// fórmula al carrito, no rehacer diez pasos.
// ─────────────────────────────────────────────────────────────

model FavoriteDrink {
  id     String @id @default(uuid())
  userId String
  /// Como la llama quien la guardó: «mi latte», «el de las mañanas».
  name   String

  /// La fórmula. Misma forma que OrderItem.options.
  build Json

  /// De qué receta salió, si salió de una del menú.
  recipeId String?
  /// El producto del catálogo al que se ancla al pedirla.
  productId String?

  /// Cuántas veces se ha pedido desde aquí. Ordena la lista sin que
  /// nadie tenga que arrastrar nada.
  timesOrdered Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timesOrdered])
}

/// What one part of a drink costs, set from the counter app. An option with no
/// row costs its default from drink-catalogue.ts, so deleting a row resets it.
model DrinkOptionPrice {
  /// beans, sizes, bases, serves, milks, foams, arts, extras, vessels or sleeves.
  group     String
  /// The option's permanent id, the same one stored inside order lines.
  optionId  String
  price     Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt

  @@id([group, optionId])
}

/// An uploaded photo, kept in the database so it survives redeploys and does
/// not depend on a mounted disk. Served at /uploads/<path>.
model StoredImage {
  /// What follows /uploads/ in its URL, e.g. "ae/ae7da13f6eabe35f.webp".
  path        String   @id
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}
