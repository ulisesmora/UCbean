DATABASE_URL=postgresql://ucbean:dev_password@localhost:5433/ucbean
JWT_SECRET=change-me-use-a-long-random-string-in-production
COOKIE_SECRET=change-me-in-production
PORT=3000
NODE_ENV=development

# ── Correo ───────────────────────────────────────────────────
# Sin esta llave los correos van al log en vez del buzón, lo que
# permite trabajar en local sin cuenta de terceros. En producción
# el arranque falla si falta, para que nunca se pierdan en silencio.
RESEND_API_KEY=
MAIL_FROM=Around the Bean <hola@aroundthebean.ca>

# Base de los enlaces que viajan en el correo (validar cuenta,
# recuperar contraseña).
APP_URL=http://localhost:3001

# ── Avisos push ──────────────────────────────────────────────
# Web Push es gratis y no tiene proveedor: estas dos llaves se
# generan en local una sola vez. Sin ellas solo se guardan las
# suscripciones, no se envía nada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@aroundthebean.ca
