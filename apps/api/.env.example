DATABASE_URL=postgresql://ucbean:dev_password@localhost:5433/ucbean
JWT_SECRET=change-me-use-a-long-random-string-in-production
COOKIE_SECRET=change-me-in-production
PORT=3000
NODE_ENV=development

# ── Correo ───────────────────────────────────────────────────
# Sin esta llave los correos van al log en vez del buzón, lo que
# permite trabajar en local sin cuenta de terceros. En producción
# el arranque falla si falta, para que nunca se pierdan en silencio.
RESEND_API_KEY=re_8NBUzAEA_EoGEerxZsXRhoeKaZEEskCmt
MAIL_FROM=Around the Bean <onboarding@resend.dev>
#  Ojo: Resend no deja enviar desde un correo de gmail ni de cualquier
#  dominio que no sea tuyo. `onboarding@resend.dev` funciona sin verificar
#  nada, pero SOLO entrega a la direccion con la que abriste la cuenta.
#  Para escribir a clientes de verdad hay que verificar el dominio en
#  resend.com/domains y poner aqui algo como hola@aroundthebean.ca

# Base de los enlaces que viajan en el correo (validar cuenta,
# recuperar contraseña).
APP_URL=http://localhost:3001

# ── Avisos push ──────────────────────────────────────────────
# Web Push es gratis y no tiene proveedor: estas dos llaves se
# generan en local una sola vez. Sin ellas solo se guardan las
# suscripciones, no se envía nada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@aroundthebean.ca

# ── Cobro con tarjeta ────────────────────────────────────────
# Las de prueba empiezan por sk_test_. La que empieza por pk_ es
# pública y va en el frontend, no aquí.
# El secreto del webhook sale de `stripe listen` en local, o del
# panel de Stripe en producción. Sin él un pedido se cobra pero
# nunca pasa a confirmado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Login con Google ─────────────────────────────────────────
# Retorno a registrar: /api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 5. Dueño del mostrador ─────────────────────────────────────
#  El CRM (localhost:3002) solo deja entrar a OWNER o STAFF.
#  `pnpm db:seed` crea este usuario si no existe, y NO pisa la
#  contraseña de uno que ya esté creado.
#
#  Si lo dejas vacío, la semilla usa  Mostrador!2026  y lo dice en
#  la consola. En producción el sembrado falla si no pones una,
#  para no dejar un administrador con clave conocida.
OWNER_EMAIL=dueno@aroundthebean.ca
OWNER_NAME=Dueño
OWNER_PASSWORD=

# Production only. See .env.production.
CORS_ORIGIN=
COOKIE_SAMESITE=strict
UPLOADS_DIR=
